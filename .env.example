# ---------------------------------------------------------------------------
# Payment Systems RAG Assistant — configuration
# Copy this file to `.env` and adjust as needed. All values have sane defaults;
# nothing here is required to run the local (Ollama) default.
# ---------------------------------------------------------------------------

# --- LLM provider selection ---------------------------------------------------
# One of: ollama | anthropic | openai
LLM_PROVIDER=ollama
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024

# Ollama (local, default). Pull the model once:  ollama pull qwen2.5:7b-instruct
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct

# Anthropic (set LLM_PROVIDER=anthropic to use)
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-5

# OpenAI or any OpenAI-compatible endpoint (set LLM_PROVIDER=openai to use)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Embeddings (local, multilingual for TR<->EN retrieval) -------------------
EMBEDDING_MODEL=intfloat/multilingual-e5-small
# cpu | cuda | cuda:0 ... . Defaults to CPU so the embedding model never competes with the
# resident Ollama LLM (and, when enabled, the reranker) for the same GPU's VRAM -- this is
# a small model and CPU inference for it is fast in absolute terms. See DECISIONS.md D27.
EMBEDDING_DEVICE=cpu

# --- Vector store (local Chroma) ----------------------------------------------
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION=payment_kb

# --- Corpus & retrieval -------------------------------------------------------
CORPUS_DIR=./data/corpus
CHUNK_SIZE=500
CHUNK_OVERLAP=80
TOP_K=4

# --- Hybrid retrieval (dense + BM25 sparse, fused with Reciprocal Rank Fusion) --
# Cheap and clearly beneficial for exact matches (error codes, endpoints) -> on.
HYBRID_ENABLED=true
RRF_K=60
BM25_K1=1.5
BM25_B=0.75

# --- Cross-encoder re-ranking -----------------------------------------------
# On by default: +64% MRR over dense-only (measured). Downloads ~2.2 GB on first use.
# The model MUST be multilingual: questions are Turkish, documents are English.
# An English-only MS-MARCO cross-encoder scores Turkish near-randomly and hurts ranking.
#
# Needs a CUDA-enabled torch to be fast (~0.13s/query, measured on an RTX 4060
# alongside a resident Ollama LLM). Falls back to CPU automatically if CUDA isn't
# available, but that costs ~6s/query — set RERANK_ENABLED=false in that case, or
# install CUDA torch:  pip install torch==<version>+cuXXX --index-url
# https://download.pytorch.org/whl/cuXXX  (match the CUDA build to your driver).
# See DECISIONS.md D15.
RERANK_ENABLED=true
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANK_CANDIDATES=20

# --- UI / app -----------------------------------------------------------------
# One process serves both the JSON API (/api/...) and the web UI (/) on this port.
APP_HOST=127.0.0.1
APP_PORT=7860
UI_LANGUAGE=tr

# --- HTTP API ------------------------------------------------------------------
# Whole-request body cap, checked before the body is read (bytes). Larger than
# MAX_UPLOAD_BYTES on purpose: log text is JSON-escaped inside the request envelope.
API_MAX_BODY_BYTES=5000000

# Per-process, best-effort rate limiting (sliding window, per client). A reverse proxy
# is still the right place for this in a multi-replica deployment — see DECISIONS.md D23.
API_RATE_LIMIT_ENABLED=true
API_RATE_LIMIT_REQUESTS=30
API_RATE_LIMIT_WINDOW_SECONDS=60

# Reverse-proxy hops to trust in X-Forwarded-For. 0 = ignore the header and use the
# socket peer. Only raise this when a proxy you control is actually in front of the app:
# every trusted hop is one an attacker can forge to evade the rate limit.
API_TRUSTED_PROXY_HOPS=0

# --- HTTP API: knowledge-base document upload (POST /api/ingest) --------------
# Per-file cap in bytes. Larger than API_MAX_BODY_BYTES on purpose — the body-size
# middleware allows this one route a bigger envelope so a real PDF fits.
API_MAX_UPLOAD_BYTES=10000000

# Tighter than API_RATE_LIMIT_* on purpose: each upload embeds+chunks+writes to Chroma
# and adds content a future query will retrieve, so it costs far more than one analyze call.
API_UPLOAD_RATE_LIMIT_REQUESTS=5
API_UPLOAD_RATE_LIMIT_WINDOW_SECONDS=3600

# --- Logging --------------------------------------------------------------
# LOG_FORMAT=json emits structured, machine-parseable lines with a propagated trace_id
# (one per request, carried through every pipeline stage). Use "text" for readable
# console output while debugging interactively.
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- Metrics (Prometheus) ---------------------------------------------------
# Collection always happens (cheap in-memory counters); this only controls whether
# an HTTP server exposes them at :METRICS_PORT/metrics for Prometheus to scrape.
# See docker-compose.observability.yml for a Prometheus + Grafana overlay.
METRICS_ENABLED=false
METRICS_PORT=9090

# --- Security: prompt injection guard ---------------------------------------
# Deterministic regex pre-filter (no LLM) that blocks obvious override/jailbreak
# patterns before the query reaches retrieval or the LLM. Cheap; on by default.
INPUT_GUARD_ENABLED=true

# --- Security: upload limits -------------------------------------------------
# Reject uploaded log files larger than this before reading them (bytes).
MAX_UPLOAD_BYTES=2000000
