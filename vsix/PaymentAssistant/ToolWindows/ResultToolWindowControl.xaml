<UserControl x:Class="PaymentAssistant.ToolWindows.ResultToolWindowControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vsshell="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
             xmlns:vsui="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
             Background="{DynamicResource {x:Static vsshell:VsBrushes.WindowKey}}"
             Foreground="{DynamicResource {x:Static vsshell:VsBrushes.WindowTextKey}}"
             mc:Ignorable="d"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="500" d:DesignWidth="420">

    <UserControl.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,12,0,4" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Status line: idle / busy / error, plus how long the last call took -->
        <StackPanel Grid.Row="0" Margin="0,0,0,6">
            <TextBlock x:Name="StatusText"
                       Text="Analiz bekleniyor."
                       TextWrapping="Wrap" />
            <TextBlock x:Name="DurationText"
                       Opacity="0.75"
                       TextWrapping="Wrap"
                       Visibility="Collapsed"
                       Text="" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Analiz Sonucu" Style="{StaticResource SectionHeader}" />
                <TextBox x:Name="AnswerText"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         BorderThickness="0"
                         Background="Transparent"
                         Foreground="{DynamicResource {x:Static vsshell:VsBrushes.WindowTextKey}}"
                         Text="" />

                <TextBlock x:Name="SourcesHeader"
                           Text="Kullanılan Kaynaklar"
                           Style="{StaticResource SectionHeader}" />
                <ListBox x:Name="SourcesList"
                         MaxHeight="200"
                         SelectionChanged="OnSourceSelectionChanged"
                         MouseDoubleClick="OnSourceDoubleClick"
                         Background="Transparent"
                         BorderThickness="0"
                         ToolTip="Ayrıntı için bir kaynağa tıklayın.">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,2">
                                <TextBlock Text="{Binding Display}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding SourcePath}"
                                           Opacity="0.7"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Selected-source detail. Knowledge-base documents live on the server,
                     not on this machine, so the usual "open the file" action is only
                     offered when the path actually resolves locally. Otherwise the
                     content is shown here instead of failing with an error. -->
                <Border x:Name="SourceDetailPanel"
                        Visibility="Collapsed"
                        Margin="0,6,0,0"
                        Padding="8"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource {x:Static vsshell:VsBrushes.ActiveBorderKey}}">
                    <StackPanel>
                        <TextBlock x:Name="SourceDetailTitle"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="SourceDetailMeta"
                                   Opacity="0.75"
                                   TextWrapping="Wrap"
                                   Margin="0,2,0,0" />
                        <TextBlock x:Name="SourceDetailExcerpt"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,0" />
                        <TextBlock x:Name="SourceDetailHint"
                                   Opacity="0.75"
                                   FontStyle="Italic"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <TextBlock Text="Güvenlik Özeti" Style="{StaticResource SectionHeader}" />
                <TextBlock x:Name="SecurityText" TextWrapping="Wrap" Text="—" />

                <TextBlock x:Name="TraceText"
                           Margin="0,12,0,0"
                           Opacity="0.7"
                           TextWrapping="Wrap"
                           Text="" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
